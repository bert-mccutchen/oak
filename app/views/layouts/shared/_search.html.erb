<div data-controller="search">
  <dialog class="modal" data-search-target="modal" data-action="keydown.<%= Setting[:search_hotkey] %>@document->search#hotkey">
    <div class="modal-box w-full max-w-xl bg-base-100/80 p-0 backdrop-blur">
      <%= turbo_frame_tag :search, src: search_path, data: { search_target: "frame", url: search_path } %>
    </div>
    <div class="modal-backdrop" data-action="click->search#hide"></div>
  </dialog>

  <div data-search-target="pull" class="pointer-events-none fixed top-4 left-0 z-20 w-screen text-center transition-opacity duration-0" style="opacity: 0">
    <span class="text-xl font-bold tracking-widest text-base-content">SEARCH</span>
  </div>
</div>
